---
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';
import BlogList from './BlogList.astro';
import PageIntro from '../institutional/PageIntro.astro';
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '@data/config';
import { paginationPath } from '../../utils/public-routes';

interface Props {
    posts: CollectionEntry<'blog'>[];
    currentPage: number;
    totalPages: number;
    canonicalUrl?: string;
    baseUrl: string;
    title: string;
    subtitle: string;
    currentCategory?: string;
}

const {
    posts: paginatedPosts,
    currentPage,
    totalPages,
    baseUrl,
    canonicalUrl,
    title,
    subtitle,
    currentCategory,
} = Astro.props;

const seoTitle = `${title} | ${siteConfig.companyName}`;
const seoDescription = subtitle;

const nextPage = currentPage < totalPages ? paginationPath(baseUrl, currentPage + 1, Boolean(canonicalUrl)) : null;
const prevPage = currentPage > 1 ? paginationPath(baseUrl, currentPage - 1, Boolean(canonicalUrl)) : null;
---

<InstitutionalLayout title={seoTitle} description={seoDescription} {canonicalUrl}>
    <PageIntro {title} description={subtitle} />
    <BlogList posts={paginatedPosts} {currentCategory} />

    {
        totalPages > 1 && (
            <nav class="blog-pagination wrap" aria-label="Paginación del blog">
                {prevPage && (
                    <a href={prevPage} rel="prev">
                        ← Anterior
                    </a>
                )}

                {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
                    <a
                        href={paginationPath(baseUrl, pageNum, Boolean(canonicalUrl))}
                        aria-label={`Página ${pageNum}`}
                        aria-current={currentPage === pageNum ? 'page' : undefined}
                    >
                        {pageNum}
                    </a>
                ))}

                {nextPage && (
                    <a href={nextPage} rel="next">
                        Siguiente →
                    </a>
                )}
            </nav>
        )
    }
</InstitutionalLayout>
<style>
    .blog-pagination {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 10px;
        padding-bottom: 48px;
        font-size: 16px;
    }
    .blog-pagination a {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        min-height: 44px;
        min-width: 44px;
        padding: 8px 13px;
        border: 1px solid var(--line);
        border-radius: 7px;
        color: var(--blue);
    }
    .blog-pagination a:hover {
        border-color: var(--blue);
    }
    .blog-pagination a[aria-current] {
        background: var(--blue);
        border-color: var(--blue);
        color: var(--paper);
    }
</style>
