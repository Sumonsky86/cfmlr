---
interface Props { id: string; title: string; }
const { id, title } = Astro.props;
if (!/^[A-Za-z0-9_-]{11}$/.test(id)) throw new Error('Identificador de video no válido');
---
<div class="yt-lite" data-id={id}>
  <img src={`https://img.youtube.com/vi/${id}/hqdefault.jpg`} alt={title} loading="lazy" width="1280" height="720" />
  <button type="button" aria-label={`Reproducir video: ${title}`}>▶</button>
</div>
<p class="clinical-video-fallback"><a href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener noreferrer">Ver entrevista en YouTube ↗</a></p>
<script>
  import '../../scripts/youtube-lite';
</script>
<style>
  .yt-lite { position: relative; display: block; aspect-ratio: 16 / 9; background: var(--ink); }
  .yt-lite > img { width: 100%; height: 100%; object-fit: cover; }
  button { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: transparent; color: white; font-size: 28px; }
  button::before { content: ''; position: absolute; left: calc(50% - 36px); top: calc(50% - 28px); width: 72px; height: 56px; border-radius: 14px; background: var(--blue); z-index: -1; }
  button { isolation: isolate; }
  .clinical-video-fallback { margin-top: 12px; }
</style>
