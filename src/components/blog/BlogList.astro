---
import BlogPost from './BlogPost.astro';
import OctoberRosePromotion from '../institutional/OctoberRosePromotion.astro';
import { categoryPath } from '../../utils/public-routes';
import type { CollectionEntry } from 'astro:content';
import { categories } from '../../data/categories';
import { getCollection } from 'astro:content';

interface Props {
    posts: CollectionEntry<'blog'>[];
    currentCategory?: string;
}

const { posts, currentCategory } = Astro.props;

const allPosts = await getCollection('blog', ({ data }) => {
    return import.meta.env.DEV || data.publish !== false;
});

const matchingPosts = currentCategory
    ? allPosts.filter((post) => post.data.categories?.includes(currentCategory))
    : allPosts;
const activeCategories = categories.filter((category) =>
    allPosts.some((post) => post.data.categories?.includes(category.name)),
);
---

<section class="blog-list wrap" aria-label="Artículos del blog">
    {Astro.url.pathname === "/blog/" && <OctoberRosePromotion />}
    <div class="blog-toolbar">
        <div>
            <h2 class="filter-heading">Filtrar por tema</h2>
            <nav class="blog-filters" aria-label="Temas del blog">
                <a href="/blog" aria-current={!currentCategory ? 'page' : undefined}>Todos</a>
                {
                    activeCategories.map((category) => (
                        <a
                            href={categoryPath(category.slug)}
                            title={category.description}
                            aria-current={currentCategory === category.name ? 'page' : undefined}
                        >
                            {category.name}
                        </a>
                    ))
                }
            </nav>
        </div>
        <p class="blog-count">
            Mostrando <strong>{posts.length}</strong> de <strong>{matchingPosts.length}</strong> artículos
        </p>
    </div>
    <div class="blog-grid">
        {
            posts.map((post, index) => (
                <BlogPost
                    title={post.data.title}
                    excerpt={post.data.excerpt}
                    featuredImage={post.data.featuredImage || ''}
                    publishDate={post.data.publishDate}
                    categories={post.data.categories || []}
                    slug={post.slug}
                    index={index}
                />
            ))
        }
    </div>
    {posts.length === 0 && <p class="blog-empty">No hay artículos en esta categoría.</p>}
</section>
<style>
    .blog-list {
        padding-block: 8px 44px;
        font-size: 16px;
    }
    .blog-toolbar {
        display: grid;
        gap: 20px;
        padding-bottom: 30px;
    }
    .filter-heading {
        font-family: var(--sans);
        font-size: 16px;
        font-weight: 600;
        letter-spacing: 0;
        margin-bottom: 12px;
    }
    .blog-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .blog-filters a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 8px 15px;
        border: 1px solid var(--line);
        border-radius: 7px;
        color: var(--text);
        line-height: 1.5;
    }
    .blog-filters a:hover {
        border-color: var(--blue);
        color: var(--blue);
    }
    .blog-filters a[aria-current] {
        background: var(--blue);
        border-color: var(--blue);
        color: var(--paper);
    }
    .blog-count {
        color: var(--text);
    }
    .blog-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 28px;
    }
    .blog-empty {
        padding-block: 32px;
        color: var(--text);
    }
    @media (max-width: 1000px) {
        .blog-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 24px;
        }
    }
    @media (max-width: 650px) {
        .blog-grid {
            grid-template-columns: minmax(0, 1fr);
        }
        .blog-list {
            padding-bottom: 30px;
        }
    }
</style>
