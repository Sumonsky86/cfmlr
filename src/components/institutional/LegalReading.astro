---
interface Props { title: string; lastUpdated: Date; dateInContent?: boolean; }
const { title, lastUpdated, dateInContent = false } = Astro.props;
const dateLabel = new Intl.DateTimeFormat('es-AR', { dateStyle: 'long', timeZone: 'UTC' }).format(lastUpdated);
---
<article class="legal-page">
  <div class="legal-frame wrap">
    <a class="legal-back" href="/legal/">← Información legal</a>
    <h1>{title}</h1>
    {!dateInContent && <p class="legal-updated">Última actualización: <time datetime={lastUpdated.toISOString()}>{dateLabel}</time></p>}
    <div class="legal-copy" data-legal-content><slot /></div>
  </div>
</article>
<style>
  .legal-page { padding-block: 32px 48px; }
  .legal-page .legal-frame { max-width: 780px; }
  .legal-back { display: inline-flex; align-items: center; min-height: 44px; margin-bottom: 14px; color: var(--blue); font-size: 14px; }
  .legal-back:hover { text-decoration: underline; text-underline-offset: 4px; }
  .legal-page h1 { font-size: clamp(36px, 4vw, 48px); line-height: 1.15; margin-bottom: 28px; }
  .legal-updated { color: var(--text); margin-bottom: 24px; font-size: 16px; }
  .legal-copy { font-size: 16px; line-height: 1.85; overflow-wrap: anywhere; }
  .legal-copy :global(p) { font-size: 16px; line-height: 1.85; margin-block: 1.2em; }
  .legal-copy :global(h2) { font-size: 30px; line-height: 1.3; margin-block: 1.5em .6em; }
  .legal-copy :global(h3) { font-family: var(--sans); font-size: 22px; font-weight: 600; line-height: 1.4; margin-block: 1.5em .6em; }
  .legal-copy :global(ul), .legal-copy :global(ol) { padding-left: 1.4em; margin-block: 1em 1.4em; }
  .legal-copy :global(ul) { list-style: disc; }
  .legal-copy :global(ol) { list-style: decimal; }
  .legal-copy :global(li) { margin-block: .5em; }
  .legal-copy :global(a) { color: var(--blue); text-decoration: underline; text-underline-offset: 4px; }
  .legal-copy :global(code) { font-size: 1em; background: var(--soft); padding: .1em .3em; border-radius: 4px; }
  .legal-copy :global(hr) { border: 0; border-top: 1px solid var(--line); margin-block: 2em; }
  @media (max-width: 650px) { .legal-page { padding-block: 22px 34px; } }
</style>
