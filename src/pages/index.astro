---
import InstitutionalLayout from '../layouts/InstitutionalLayout.astro';
import Hero from '../components/institutional/Hero.astro';
import Services from '../components/institutional/Services.astro';
import Conversations from '../components/institutional/Conversations.astro';
import Visit from '../components/institutional/Visit.astro';
import Journal from '../components/institutional/Journal.astro';
const title = 'Cefem – Centro Familiar de Especialidades Médicas en Las Rosas';
const description = 'Cefem en Las Rosas: Atención integral en Pediatría, Urología, Ginecología y más. Cuidamos de tu familia con especialistas de confianza.';
---
<InstitutionalLayout {title} {description} canonicalUrl="/">
  <Hero />
  <Services compact={true} />
  <Conversations />
  <Visit />
  <Journal />
</InstitutionalLayout>
