---
import InstitutionalLayout from '../layouts/InstitutionalLayout.astro';
---
<InstitutionalLayout title="Página no encontrada" description="La página que buscás no existe o cambió de dirección. Encontrá las especialidades y los datos de contacto de CEFEM en Las Rosas." robots="noindex, follow">
  <section class="wrap missing-page" aria-labelledby="missing-title">
    <p class="eyebrow">Error 404</p>
    <h1 id="missing-title">Página no encontrada</h1>
    <p>La página que buscás no existe o cambió de dirección. Revisá la dirección o usá estos enlaces para continuar.</p>
    <nav aria-label="Opciones para continuar">
      <a href="/">Volver al inicio</a>
      <a href="/especialidades/">Ver especialidades</a>
      <a href="/contacto/">Contactar a CEFEM</a>
    </nav>
  </section>
</InstitutionalLayout>
<style>
  .missing-page { padding-block: clamp(4rem, 10vw, 8rem); min-height: 50vh; }
  .missing-page h1 { margin-block: 1rem; }
  .missing-page p { max-width: 42rem; }
  .missing-page nav { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 2rem; }
  .missing-page a { text-decoration: underline; text-underline-offset: .2em; }
</style>
