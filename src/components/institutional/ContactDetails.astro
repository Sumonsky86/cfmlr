---
import { Image } from 'astro:assets';
import mapImage from '../../assets/images/map.jpg';
import { appointmentContact as contact, appointmentLinks as links } from '../../data/appointments';
---
<section class="contact-details wrap" aria-labelledby="contact-location-title">
  <div class="contact-information">
    <h2 id="contact-location-title">Encontranos en Las Rosas</h2>
    <dl>
      <div><dt>Dirección</dt><dd><a href={links.maps} target="_blank" rel="noopener noreferrer">{contact.address}<br />{contact.locality}</a></dd></div>
      <div><dt>Horarios de recepción</dt><dd>{contact.openingDays}<br />{contact.openingTimeRanges}</dd></div>
      <div><dt>Teléfono</dt><dd><a href={links.phone}>{contact.phoneDisplay}</a></dd></div>
      <div><dt>Correo electrónico</dt><dd><a href={links.email}>{contact.email}</a></dd></div>
    </dl>
    <div class="contact-actions">
      <a class="button button-primary" href={links.whatsapp} target="_blank" rel="noopener noreferrer">Escribir por WhatsApp <span aria-hidden="true">↗</span></a>
      <a class="button button-outline" href={links.phone}>Llamar a recepción</a>
    </div>
    <p class="appointment-note">Para preparar tu solicitud de turno, <a href="/turnos/">completá el formulario</a> y continuá por WhatsApp. Recepción confirma la disponibilidad.</p>
  </div>
  <div class="contact-map">
    <a class="map-preview" href={links.maps} target="_blank" rel="noopener noreferrer" aria-label="Ver ubicación de CEFEM en Google Maps">
      <Image src={mapImage} alt="Mapa de la ubicación de CEFEM en Las Rosas" width={800} format="webp" quality={80} loading="lazy" />
    </a>
    <a class="map-directions" href={links.maps} target="_blank" rel="noopener noreferrer">Cómo llegar en Google Maps <span aria-hidden="true">↗</span></a>
    <p>El mapa se abre en una nueva pestaña.</p>
  </div>
</section>
<style>
  .contact-details { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: start; padding-bottom: 56px; }
  .contact-information h2 { font-size: 32px; line-height: 1.2; }
  .contact-information dl { display: grid; gap: 17px; margin: 25px 0 23px; }
  .contact-information dt { color: var(--text); font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  .contact-information dd { margin: 4px 0 0; font-size: 16px; color: var(--ink); }
  .contact-information dd a { display: inline-flex; flex-direction: column; justify-content: center; min-height: 44px; overflow-wrap: anywhere; }
  .contact-information dd a:hover { color: var(--blue); text-decoration: underline; text-underline-offset: 4px; }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .contact-actions .button { gap: 12px; }
  .contact-information .appointment-note { max-width: 480px; margin-top: 20px; color: var(--text); font-size: 16px; }
  .appointment-note a { color: var(--blue); text-decoration: underline; text-underline-offset: 4px; }
  .contact-map { min-width: 0; padding-top: 4px; }
  .map-preview { display: block; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--soft); }
  .map-preview img { width: 100%; height: auto; }
  .map-directions { display: inline-flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 48px; margin-top: 10px; color: var(--blue); font-weight: 600; }
  .map-directions:hover { text-decoration: underline; text-underline-offset: 4px; }
  .contact-map p { color: var(--text); font-size: 14px; }
  @media (max-width: 900px) { .contact-details { gap: 32px; } }
  @media (max-width: 767px) { .contact-details { grid-template-columns: minmax(0, 1fr); gap: 32px; padding-bottom: 36px; } .contact-information h2 { font-size: 29px; } }
</style>
