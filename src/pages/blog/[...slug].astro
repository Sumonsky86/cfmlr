---
import { getCollection, render } from 'astro:content';
import InstitutionalLayout from '@layouts/InstitutionalLayout.astro';
import ArticleHeader from '@components/institutional/ArticleHeader.astro';
import ArticleContent from '@components/institutional/ArticleContent.astro';
import ArticleSeo from '@components/institutional/ArticleSeo.astro';
import ArticleToc from '@components/institutional/ArticleToc.astro';
import ArticleContext from '@components/institutional/ArticleContext.astro';
import BlogPost from '@components/blog/BlogPost.astro';
import { Image } from 'astro:assets';
import { siteConfig } from '@data/config';
import { categories } from '@data/categories';
import { categoryPath } from '../../utils/public-routes';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
    .filter((p) => {
        if (p.slug === post.slug || p.data.publish === false) return false;
        return p.data.categories.some((cat) => post.data.categories.includes(cat));
    })
    .slice(0, 3);

const seoTitle = post.data.seo?.title || post.data.title;
const seoDescription = post.data.seo?.description || post.data.excerpt;
const siteUrl = Astro.site || siteConfig.siteUrl;
let seoImage: string | undefined = post.data.seo?.image;
if (seoImage && !seoImage.startsWith('http')) {
    seoImage = new URL(seoImage.startsWith('/') ? seoImage : `/${seoImage}`, siteUrl).toString();
} else if (!seoImage && post.data.featuredImage) {
    seoImage = new URL(post.data.featuredImage.src.src, siteUrl).toString();
}
const postCategories = post.data.categories
    .map((name) => categories.find((category) => category.name === name))
    .filter((category) => category !== undefined);
const breadcrumbs = [
    { name: 'Inicio', href: '/' },
    { name: 'Blog', href: '/blog' },
    { name: post.data.title, href: Astro.url.pathname },
];
---

<InstitutionalLayout title={seoTitle} description={seoDescription} image={seoImage} ogType="article">
    <ArticleSeo slot="head" title={post.data.title} description={post.data.excerpt} publishDate={post.data.publishDate} canonicalUrl={new URL(Astro.url.pathname, siteConfig.siteUrl).href} image={seoImage} breadcrumbs={breadcrumbs} />
    <article class="blog-article">
        <div class="blog-reading-frame wrap">
            <ArticleHeader title={post.data.title} excerpt={post.data.excerpt} publishDate={post.data.publishDate} categories={postCategories.map((category) => ({ name: category.name, href: categoryPath(category.slug) }))} breadcrumbs={breadcrumbs} />
            {
                post.data.featuredImage && (
                    <Image
                        src={post.data.featuredImage.src}
                        alt={post.data.featuredImage.alt}
                        width={Math.min(1200, post.data.featuredImage.src.width)}
                        class="blog-featured-image"
                        quality={80}
                        format="webp"
                    />
                )
            }
            <ArticleToc headings={headings} />
            <ArticleContent><Content /></ArticleContent>
            <ArticleContext categories={post.data.categories} />
            <a class="blog-back" href="/blog">← Todos los artículos</a>
        </div>
    </article>

    {
        relatedPosts.length > 0 && (
            <section class="blog-related wrap" aria-labelledby="blog-related-heading">
                <h2 id="blog-related-heading">Artículos relacionados</h2>
                <div class="blog-related-grid">
                    {relatedPosts.map((relatedPost) => (
                        <BlogPost
                            title={relatedPost.data.title}
                            excerpt={relatedPost.data.excerpt}
                            featuredImage={relatedPost.data.featuredImage}
                            publishDate={relatedPost.data.publishDate}
                            categories={relatedPost.data.categories}
                            slug={relatedPost.slug}
                            headingLevel="h3"
                        />
                    ))}
                </div>
            </section>
        )
    }
</InstitutionalLayout>
<style>
    .blog-article {
        padding-bottom: 40px;
        font-size: 16px;
    }
    .blog-article .blog-reading-frame {
        max-width: 780px;
    }
    .blog-featured-image {
        width: 100%;
        height: auto;
        max-height: 360px;
        object-fit: contain;
        border-radius: 10px;
        margin-bottom: 32px;
    }
    .blog-back {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        color: var(--blue);
        margin-top: 24px;
    }
    .blog-back:hover {
        text-decoration: underline;
        text-underline-offset: 4px;
    }
    .blog-related {
        padding-block: 32px 48px;
        border-top: 1px solid var(--line);
        font-size: 16px;
    }
    .blog-related > h2 {
        font-size: clamp(30px, 3vw, 38px);
        line-height: 1.25;
        margin-bottom: 26px;
    }
    .blog-related-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 28px;
    }
    @media (max-width: 1000px) {
        .blog-related-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 24px;
        }
    }
    @media (max-width: 650px) {
        .blog-featured-image { max-height: 220px; }
        .blog-related-grid {
            grid-template-columns: minmax(0, 1fr);
        }
        .blog-related {
            padding-block: 28px 32px;
        }
    }
    @media (max-width: 650px) {
        .blog-article {
            padding-bottom: 28px;
        }
    }
</style>
