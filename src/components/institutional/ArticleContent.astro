---
// Keep rendered Markdown/MDX inside this boundary, never global prose rules.
---

<div class="institutional-reading" data-blog-content><slot /></div>
<script>
    import '../../scripts/youtube-lite';
</script>
<style>
    .institutional-reading {
        font-family: var(--sans);
        font-size: 16px;
        line-height: 1.85;
        color: var(--ink);
        overflow-wrap: anywhere;
    }
    .institutional-reading :global(p) {
        margin-block: 1.2em;
        font-size: 16px;
        line-height: 1.85;
    }
    .institutional-reading :global(h2) {
        font-family: var(--serif);
        font-size: clamp(28px, 3vw, 36px);
        font-weight: 400;
        letter-spacing: -0.03em;
        line-height: 1.25;
        margin-block: 1.6em 0.6em;
        scroll-margin-top: 110px;
    }
    .institutional-reading :global(h3),
    .institutional-reading :global(h4),
    .institutional-reading :global(h5),
    .institutional-reading :global(h6) {
        font-family: var(--sans);
        font-size: 21px;
        line-height: 1.4;
        margin-block: 1.5em 0.6em;
        scroll-margin-top: 110px;
    }
    .institutional-reading :global(a) {
        color: var(--blue);
        text-decoration: underline;
        text-underline-offset: 4px;
    }
    .institutional-reading :global(a:hover) {
        color: var(--blue-deep);
    }
    .institutional-reading :global(a:focus-visible),
    .institutional-reading :global(button:focus-visible) {
        outline: 3px solid var(--blue);
        outline-offset: 4px;
    }
    .institutional-reading :global(ul),
    .institutional-reading :global(ol) {
        margin-block: 1em 1.4em;
        padding-left: 1.6em;
        font-size: 16px;
        line-height: 1.85;
    }
    .institutional-reading :global(ul) {
        list-style: disc;
    }
    .institutional-reading :global(ol) {
        list-style: decimal;
    }
    .institutional-reading :global(li) {
        padding-left: 0.25em;
        margin-block: 0.45em;
    }
    .institutional-reading :global(li > ul),
    .institutional-reading :global(li > ol) {
        margin-block: 0.5em;
    }
    .institutional-reading :global(blockquote) {
        margin: 1.6em 0;
        padding: 6px 24px;
        border-left: 3px solid var(--blue);
        background: var(--soft);
        color: var(--text);
    }
    .institutional-reading :global(img) {
        max-width: 100%;
        height: auto;
        margin-block: 1.5em;
        border-radius: 8px;
    }
    .institutional-reading :global(figure) {
        max-width: 100%;
        margin: 1.6em 0;
    }
    .institutional-reading :global(figcaption) {
        margin-top: 0.65em;
        color: var(--text);
        font-size: 16px;
    }
    .institutional-reading :global(hr) {
        border: 0;
        border-top: 1px solid var(--line);
        margin-block: 2em;
    }
    .institutional-reading :global(pre) {
        max-width: 100%;
        overflow-x: auto;
        padding: 20px;
        background: var(--soft);
        border: 1px solid var(--line);
        border-radius: 8px;
        font-size: 16px;
        line-height: 1.7;
        white-space: pre;
        overflow-wrap: normal;
    }
    .institutional-reading :global(code) {
        font-size: 1em;
        font-family: ui-monospace, monospace;
    }
    .institutional-reading :global(:not(pre) > code) {
        background: var(--soft);
        padding: 0.12em 0.3em;
        border-radius: 4px;
    }
    .institutional-reading :global(table) {
        display: block;
        max-width: 100%;
        overflow-x: auto;
        border-collapse: collapse;
        margin-block: 1.5em;
        font-size: 16px;
    }
    .institutional-reading :global(th),
    .institutional-reading :global(td) {
        padding: 12px 16px;
        border: 1px solid var(--line);
        text-align: left;
    }
    .institutional-reading :global(th) {
        background: var(--soft);
    }
    .institutional-reading :global(iframe),
    .institutional-reading :global(video) {
        max-width: 100%;
    }
    .institutional-reading :global(.yt-lite) {
        margin-block: 1.5em;
        border-radius: 8px;
        overflow: hidden;
    }
    .institutional-reading :global(.yt-lite > img) {
        height: 100%;
        margin: 0;
        border-radius: 0;
    }
    .institutional-reading :global([data-interview-timeline]) {
        margin-block: 2em;
        padding: 22px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--paper);
    }
    .institutional-reading :global(.timeline-year) {
        color: var(--blue);
        font-weight: 700;
        font-size: 18px;
        margin-bottom: 14px;
    }
    .institutional-reading :global(.timeline-item) {
        padding-block: 12px 24px;
        border-bottom: 1px solid var(--line);
        margin-bottom: 18px;
    }
    .institutional-reading :global(.timeline-item h3) {
        margin-block: 10px;
    }
    .institutional-reading :global(.timeline-item button) {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 44px;
        padding: 8px 16px;
        border: 1px solid var(--blue);
        border-radius: 7px;
        color: var(--blue);
        background: var(--paper);
        font-size: 16px;
    }
    .institutional-reading :global([data-video-container].hidden) {
        display: none;
    }
    @media (max-width: 650px) {
        .institutional-reading :global(blockquote) {
            padding-inline: 18px;
        }
        .institutional-reading :global([data-interview-timeline]) {
            padding: 16px;
        }
    }
</style>
