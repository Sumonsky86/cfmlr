---
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';
import PageIntro from '../../components/institutional/PageIntro.astro';
import { appointmentLinks } from '../../data/appointments';
// Keep the existing destination; authentication and files belong to the separate backend.
const portalUrl = 'https://resultados.cefem.ar';
---
<InstitutionalLayout title="Consultar Estudios Médicos Online | Cefem Las Rosas" description="Ingresá al portal de resultados de Cefem para descargar tus estudios médicos y compartirlos con tus especialistas." canonicalUrl="/mis-estudios/">
  <PageIntro title="Mis estudios" description="Accedé a tus resultados y estudios realizados en Cefem directamente desde casa." />
  <div class="study-access wrap">
    <section class="study-entry" aria-labelledby="study-entry-title">
      <h2 id="study-entry-title">Ingresar al portal de estudios</h2>
      <p>Si realizaste un estudio en <strong>Cefem – Centro Familiar de Especialidades Médicas</strong>, podés consultar el informe digital y las imágenes disponibles desde el portal de resultados.</p>
      <p>Tené a mano los datos de acceso que te entregó recepción. El acceso a tus archivos se realiza dentro del portal, en una nueva pestaña.</p>
      <a class="button button-primary portal-entry" href={portalUrl} target="_blank" rel="noopener noreferrer">Entrar al portal <span aria-hidden="true">↗</span></a>
    </section>
    <aside class="study-help" aria-labelledby="study-help-title">
      <h2 id="study-help-title">¿Necesitás ayuda?</h2>
      <p>Si no recibiste tus datos de acceso o tenés dificultades para ingresar, comunicate con recepción.</p>
      <a class="button button-outline" href={appointmentLinks.whatsapp} target="_blank" rel="noopener noreferrer">Ayuda por WhatsApp <span aria-hidden="true">↗</span></a>
      <a class="study-contact" href="/contacto/">Otros medios de contacto →</a>
      <p class="study-privacy">Por privacidad, no incluyas tu clave de acceso en mensajes.</p>
    </aside>
  </div>
</InstitutionalLayout>
<style>
  .study-access { display: grid; grid-template-columns: minmax(0,1.4fr) minmax(0,1fr); gap: 32px; padding-bottom: 52px; }
  .study-entry, .study-help { padding: 28px; border: 1px solid var(--line); border-radius: 12px; }
  .study-help { background: var(--soft); }
  .study-access h2 { font-size: 30px; line-height: 1.25; }
  .study-access p { font-size: 16px; line-height: 1.75; color: var(--text); margin-top: 16px; }
  .study-access .button { margin-top: 24px; gap: 12px; }
  .study-contact { display: flex; align-items: center; min-height: 44px; margin-top: 12px; color: var(--blue); }
  .study-contact:hover { text-decoration: underline; text-underline-offset: 4px; }
  .study-help .study-privacy { border-top: 1px solid var(--line); padding-top: 16px; }
  @media (max-width: 767px) { .study-access { grid-template-columns: minmax(0,1fr); gap: 22px; padding-bottom: 34px; } .study-entry, .study-help { padding: 22px; } .study-access h2 { font-size: 28px; } }
</style>
