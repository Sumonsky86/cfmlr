---
interface Props {
    title: string;
    excerpt: string;
    publishDate: Date;
    categories: { name: string; href: string }[];
    breadcrumbs: { name: string; href: string }[];
}
const { title, excerpt, publishDate, categories, breadcrumbs } = Astro.props;
const formattedDate = publishDate.toLocaleDateString('es-ES', {
    year: 'numeric', month: 'long', day: 'numeric',
});
---
<header class="article-header">
    <nav class="article-breadcrumbs" aria-label="Ruta de navegación">
        <ol>
            {breadcrumbs.map((crumb, index) => (
                <li aria-current={index === breadcrumbs.length - 1 ? 'page' : undefined}>
                    {index === breadcrumbs.length - 1 ? <span>{crumb.name}</span> : <a href={crumb.href}>{crumb.name}</a>}
                </li>
            ))}
        </ol>
    </nav>
    <h1>{title}</h1>
    <p class="article-lead">{excerpt}</p>
    <div class="blog-article-meta">
        <p class="article-date">Publicado el <time class="blog-publish-date" datetime={publishDate.toISOString()}>{formattedDate}</time></p>
        <div class="blog-article-topics" aria-label="Temas del artículo">
            {categories.map((category) => <a href={category.href}>{category.name}</a>)}
        </div>
    </div>
</header>
<style>
    .article-header {
        padding-block: 28px 24px;
        overflow-wrap: anywhere;
        font-size: 16px;
    }
    .article-breadcrumbs ol {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 10px;
        list-style: none;
        padding: 0;
        margin: 0 0 24px;
        color: var(--text);
        line-height: 1.6;
    }
    .article-breadcrumbs li:not(:first-child)::before {
        content: '/';
        padding-right: 10px;
        color: var(--text);
    }
    .article-header a {
        color: var(--blue);
        text-decoration: underline;
        text-underline-offset: 4px;
    }
    .article-header h1 {
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(34px, 4.5vw, 52px);
        line-height: 1.12;
        letter-spacing: -0.035em;
        text-wrap: pretty;
    }
    .article-header .article-lead {
        margin-top: 20px;
        color: var(--text);
        font-size: 18px;
        line-height: 1.75;
    }
    .blog-article-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 24px;
        padding-block: 22px 16px;
        border-bottom: 1px solid var(--line);
        color: var(--text);
        font-size: 16px;
    }
    .blog-article-topics {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 18px;
    }
    .blog-article-topics a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
    }
    @media (max-width: 650px) {
        .article-header { padding-top: 20px; }
        .article-breadcrumbs ol { margin-bottom: 20px; }
        .article-header .article-lead { font-size: 16px; }
    }
</style>
