---
import { additionalServices } from '../../data/additional-services';
interface Props { showHeading?: boolean; compact?: boolean; }
const urology = additionalServices.find(service => service.appointmentId === 'urology')!;
const generalMedicine = additionalServices.find(service => service.appointmentId === 'general-medicine')!;
const hairRemoval = additionalServices.find(service => service.appointmentId === 'laser-hair-removal')!;
const { showHeading = true, compact = false } = Astro.props;
const ServiceTitle = showHeading ? 'h3' : 'h2';
---
<section id="especialidades" class="services" aria-labelledby={showHeading ? 'services-title' : undefined} aria-label={showHeading ? undefined : 'Especialidades y servicios'}><div class="wrap">{showHeading && <div class="section-heading"><div><div class="eyebrow">Especialidades y servicios</div><h2 id="services-title">La atención que necesitás.</h2></div>{!compact && <p>Conocé nuestras áreas de atención y consultá a recepción por disponibilidad de turnos.</p>}</div>}<div class="service-list"><article class="service"><ServiceTitle><a href="/ecografias-las-rosas/">Ecografías<span class="arrow" aria-hidden="true">→</span></a></ServiceTitle><p>{compact ? 'Generales, obstétricas, Doppler y urológicas.' : 'Ecografías generales, obstétricas, Doppler y urológicas con tecnología avanzada y atención personalizada.'}</p></article><article class="service"><ServiceTitle><a href="/traumatologia/">Traumatología<span class="arrow" aria-hidden="true">→</span></a></ServiceTitle><p>{compact ? 'Lesiones, fracturas y cuidado de articulaciones.' : 'Atención de lesiones, fracturas y dolencias del sistema locomotor. Tratamientos para recuperar tu movilidad y bienestar.'}</p></article><article class="service"><ServiceTitle><a href="/pediatria/">Pediatría<span class="arrow" aria-hidden="true">→</span></a></ServiceTitle><p>{compact ? 'Controles de salud y desarrollo infantil.' : 'Atención integral infantil en Cefem, con especialistas que acompañan el desarrollo y salud de tus hijos.'}</p></article><article class="service"><ServiceTitle><a href={`/${urology.slug}/`}>{urology.title}<span class="arrow" aria-hidden="true">→</span></a></ServiceTitle><p>{compact ? 'Atención urológica para hombres y mujeres.' : urology.description}</p></article><article class="service"><ServiceTitle><a href="/ginecologia-obstetricia/">Ginecología y Obstetricia<span class="arrow" aria-hidden="true">→</span></a></ServiceTitle><p>{compact ? 'Controles ginecológicos y seguimiento del embarazo.' : 'Controles y seguimiento de embarazos con especialistas de confianza.'}</p></article><article class="service"><ServiceTitle><a href="/nutricion/">Nutrición<span class="arrow" aria-hidden="true">→</span></a></ServiceTitle><p>{compact ? 'Alimentación y hábitos según tus necesidades.' : 'Planes de alimentación personalizados para mejorar hábitos, controlar peso y como soporte en diversas patologías.'}</p></article><article class="service"><ServiceTitle><a href={`/${generalMedicine.slug}/`}>{generalMedicine.title}<span class="arrow" aria-hidden="true">→</span></a></ServiceTitle><p>{compact ? 'Atención clínica y seguimiento de tu salud.' : generalMedicine.description}</p></article><article class="service"><ServiceTitle><a href={`/${hairRemoval.slug}/`}>{hairRemoval.title}<span class="arrow" aria-hidden="true">→</span></a></ServiceTitle><p>{compact ? 'Consultas sobre el tratamiento.' : hairRemoval.description}</p></article></div><div class="service-bottom">{showHeading && <a class="inline-link" href="/especialidades/">Ver todas las especialidades <span class="arrow" aria-hidden="true">→</span></a>}<nav class="medical-links" aria-label="Estudios y servicios específicos"><p>Estudios y servicios específicos</p><ul><li><a href="/ecografias-abdominales-las-rosas/">Ecografías abdominales</a></li><li><a href="/ecografias-doppler-embarazo-las-rosas/">Ecografías Doppler en embarazo</a></li><li><a href="/ecografias-partes-blandas-lesiones-deportivas/">Ecografías de partes blandas</a></li><li><a href="/cirugia-vascular-varices-las-rosas/">Cirugía vascular y várices</a></li></ul></nav></div></div></section>
