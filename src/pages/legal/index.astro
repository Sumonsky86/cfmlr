---
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';
import PageIntro from '../../components/institutional/PageIntro.astro';
import { getCollection } from 'astro:content';
import { legalPath } from '../../utils/public-routes';
const entries = (await getCollection('legal')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const dateLabel = (date: Date) => new Intl.DateTimeFormat('es-AR', { dateStyle: 'long', timeZone: 'UTC' }).format(date);
---
<InstitutionalLayout title="Información legal | Cefem" description="Consultá la política de privacidad y los términos y condiciones del sitio de Cefem." canonicalUrl="/legal/">
  <PageIntro title="Información legal" description="Políticas y condiciones de uso de nuestro sitio y sus servicios." />
  <section class="legal-index wrap" aria-label="Documentos legales">
    <div class="legal-list">{entries.map(entry => <a class="legal-document-link" href={legalPath(entry.slug)}>
      <h2>{entry.data.title}<span aria-hidden="true">→</span></h2>
      <p>Última actualización: <time datetime={entry.data.lastUpdated.toISOString()}>{dateLabel(entry.data.lastUpdated)}</time></p>
    </a>)}</div>
  </section>
</InstitutionalLayout>
<style>
  .legal-index { padding-bottom: 48px; }
  .legal-list { max-width: 780px; }
  .legal-document-link { display: block; padding-block: 24px; border-top: 1px solid var(--line); }
  .legal-document-link:last-child { border-bottom: 1px solid var(--line); }
  .legal-document-link h2 { display: flex; align-items: center; justify-content: space-between; gap: 22px; font-size: 28px; line-height: 1.3; }
  .legal-document-link:hover h2 { color: var(--blue); }
  .legal-document-link span { color: var(--blue); font-family: var(--sans); font-size: 20px; }
  .legal-document-link p { color: var(--text); margin-top: 12px; font-size: 16px; }
</style>
